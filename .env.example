# ─── Sound & Stone environment configuration ───────────────────────────────
# Copy to .env.local for development. Set the same keys in Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are embedded at build time: redeploy after changing them.

# Public site
NEXT_PUBLIC_SITE_URL=https://soundandstoneweddings.com
# Set to "true" on preview/staging deployments to block search indexing.
NEXT_PUBLIC_NOINDEX=

# Real business contact details (leave blank until they exist — the UI hides blanks)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_PINTEREST_URL=
# Booking link offered after a successful inquiry (Calendly, HoneyBook scheduler…)
NEXT_PUBLIC_SCHEDULING_URL=

# ─── Lead delivery (at least ONE primary channel is required in production) ──
# Option A — email via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=            # team inbox(es), comma-separated
INQUIRY_FROM_EMAIL=          # e.g. "Sound & Stone <inquiries@soundandstoneweddings.com>"
INQUIRY_SEND_ACK=true        # set "false" to skip the acknowledgment email to couples

# Option B — CRM webhook (Zapier/Make catch hook → HoneyBook, HubSpot, Airtable, Google Sheets)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=         # sent as X-Webhook-Secret; verify it in your automation

# ─── Spam protection & rate limiting (recommended) ──────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=      # shared rate limiting across serverless instances
UPSTASH_REDIS_REST_TOKEN=
INQUIRY_HASH_SALT=           # any random string; used to hash client IPs for rate limiting

# ─── Analytics ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=           # GA4 measurement ID, e.g. G-XXXXXXX

# ─── Testing only ───────────────────────────────────────────────────────────
# RESEND_API_BASE=http://localhost:4010   # point Resend calls at scripts/mock-integrations.mjs
